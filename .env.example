# ========================================
# OpenClaw Dockerized Bot - Environment Variables
# ========================================
# 複製此檔案為 .env 並填入你的值
# cp .env.example .env

# === OpenClaw Gateway ===
OPENCLAW_GATEWAY_TOKEN=your_gateway_token_here
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=lan

# === LLM Provider ===
# 如果使用 OAuth (如 OpenAI Codex / Claude Pro)，不需要填 API Key
# OAuth 認證透過 `openclaw onboard` 完成，資料存在 openclaw-data/agents/

# Anthropic API Key (如果不用 OAuth)
# ANTHROPIC_API_KEY=

# OpenAI API Key (如果不用 OAuth)
# OPENAI_API_KEY=

# === Chat Platform Tokens (依需求填寫) ===

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# === Docker 設定 ===
OPENCLAW_IMAGE=openclaw:local
OPENCLAW_CONFIG_DIR=./openclaw-data
